/// --- 1. CONFIGURATION ---
let flashDuration = 1; 
let flashChance = 0.001;   

// --- 2. STATE TRACKING ---
let isFlashing = false;
let flashStartTime = 0;
let peakFlashValue = 0; 

// --- 3. CORE LOGIC WITH EASE-IN-EASE-OUT ENVELOPE ---
const autoSmoothSwell = () => {
  let currentTime = time; 

  // State A: Visual swell is active
  if (isFlashing) {
    let elapsed = currentTime - flashStartTime;


    if (elapsed > flashDuration) {
      isFlashing = false; 
    } else {

      let t = elapsed / flashDuration;
      

      let smoothEnvelope = Math.sin(t * Math.PI);
      

      return peakFlashValue * smoothEnvelope;
    }
  }


  if (!isFlashing && Math.random() < flashChance) {
    isFlashing = true;
    flashStartTime = currentTime;

    peakFlashValue = Math.random(); 
    return 0;
  }

  // State C: Default idle baseline
  return 0;
};


