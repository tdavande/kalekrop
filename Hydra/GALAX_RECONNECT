
// --- Step 1: Initialize Environment Parameters ---
speed = 1.0;
let renderSize = 1024; 

await loadScript("https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js")

// --- Step 2: Establish Scene & Camera Parameters ---
const scene = new THREE.Scene();
scene.fog = new THREE.FogExp2(0x000000, 0.035); 

const camera = new THREE.PerspectiveCamera(60, 1, 0.1, 35);
const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: false });
renderer.setSize(renderSize, renderSize);
renderer.setClearColor(0x000000, 1.0); 

// --- Step 3: High-Definition Procedural Deep Field Texture Generator ---
const createCosmicTexture = (style) => {
    const canvas = document.createElement('canvas');
    canvas.width = 512;
    canvas.height = 512;
    const ctx = canvas.getContext('2d');
    
    ctx.fillStyle = '#000000';
    ctx.fillRect(0, 0, 512, 512);
    
    if (style === 'stars') {
        for (let i = 0; i < 400; i++) {
            let x = Math.random() * 512;
            let y = Math.random() * 512;
            let size = Math.random() * 2 + 0.5;
            let alpha = Math.random() * 0.7 + 0.3;
            
            let rand = Math.random();
            if (rand < 0.3) ctx.fillStyle = `rgba(130, 180, 255, ${alpha})`;
            else if (rand < 0.6) ctx.fillStyle = `rgba(255, 210, 140, ${alpha})`;
            else ctx.fillStyle = `rgba(255, 255, 255, ${alpha})`;
            
            ctx.fillRect(x, y, size, size);
        }
    } else {
        const cx = 256, cy = 256;
        const grad = ctx.createRadialGradient(cx, cy, 10, cx, cy, 250);
        grad.addColorStop(0.0, 'rgba(140, 45, 180, 0.3)');  
        grad.addColorStop(0.4, 'rgba(35, 75, 160, 0.15)');   
        grad.addColorStop(1.0, 'rgba(0, 0, 0, 0.0)');         
        ctx.fillStyle = grad;
        ctx.fillRect(0, 0, 512, 512);
    }
    return new THREE.CanvasTexture(canvas);
};

const texStars = createCosmicTexture('stars');
const texNebula = createCosmicTexture('nebula');

// --- Step 4: Build Deterministic Night Sky Parallax Matrix ---
const skyPlanes = [];
const totalSkyPlanes = 80;
const skyGeo = new THREE.PlaneGeometry(6.0, 6.0); 

const skyLayouts = [];
for (let i = 0; i < totalSkyPlanes; i++) {
    let seedX = Math.sin(i * 432.12);
    let seedY = Math.cos(i * 678.54);
    let seedZ = Math.sin(i * 123.45);
    
    skyLayouts.push({
        x: seedX * 14.0,
        y: seedY * 9.0,
        zStart: seedZ * 28.0, 
        type: i % 2 === 0 ? texStars : texNebula,
        scale: Math.abs(seedX) * 2.5 + 1.5,
        opacity: Math.abs(seedY) * 0.4 + 0.2,
        rotZ: seedZ * Math.PI
    });
}

skyLayouts.forEach(layout => {
    const skyMat = new THREE.MeshBasicMaterial({
        map: layout.type,
        transparent: true,
        opacity: layout.opacity,
        blending: THREE.AdditiveBlending,
        depthWrite: false
    });
    
    const mesh = new THREE.Mesh(skyGeo, skyMat);
    mesh.position.set(layout.x, layout.y, layout.zStart);
    mesh.scale.set(layout.scale, layout.scale, 1.0);
    mesh.rotation.z = layout.rotZ;
    
    scene.add(mesh);
    skyPlanes.push({ mesh: mesh, zStart: layout.zStart });
});

// --- Step 5: Populate Large-Scale Procedural Black Holes ---
const blackHoles = [];
const totalBlackHoles = 5; 

const holeGeo = new THREE.SphereGeometry(0.45, 32, 32); 
const holeMat = new THREE.MeshBasicMaterial({ color: 0x000000 });

const diskGeo = new THREE.RingGeometry(0.60, 2.8, 64); 

for (let i = 0; i < totalBlackHoles; i++) {
    const group = new THREE.Group();
    const core = new THREE.Mesh(holeGeo, holeMat);
    group.add(core);

    // Dynamic color setup: give each disk its own distinct texture-drawing context instance
    const bCanvas = document.createElement('canvas');
    bCanvas.width = 512;
    bCanvas.height = 512;
    const bCtx = bCanvas.getContext('2d');
    const bTex = new THREE.CanvasTexture(bCanvas);

    const diskMat = new THREE.MeshBasicMaterial({ 
        map: bTex, 
        side: THREE.DoubleSide, 
        transparent: true,
        blending: THREE.AdditiveBlending 
    });

    const disk = new THREE.Mesh(diskGeo, diskMat);
    group.add(disk);

    let bSeedX = Math.sin(i * 23.45);
    let bSeedY = Math.cos(i * 45.67);
    let bSeedZ = Math.sin(i * 89.12);

    const config = {
        x: bSeedX * 3,                                       
        y: bSeedY * 2.5,                                       
        zStart: -((i / totalBlackHoles) * 28.0),               
        spinCycles: Math.round(bSeedX * 60) + (i % 2 === 0 ? 90 : -90), 
        rotCyclesX: Math.round(bSeedY * 12),
        rotCyclesY: Math.round(bSeedZ * 12),
        colorWaveFreq: (i % 2 === 0 ? 4 : 3) // Number of full color shifts over 3 mins
    };

    group.position.set(config.x, config.y, config.zStart);
    scene.add(group);
    
    blackHoles.push({
        mesh: group,
        diskMesh: disk,
        canvas: bCanvas,
        ctx: bCtx,
        texture: bTex,
        config: config,
        index: i
    });
}

// --- Step 6: Unified Loop Clock & Execution Mechanics ---
const clock = new THREE.Clock();
const cameraTarget = new THREE.Vector3();
const LOOP_DURATION = 180; 
const totalZSpan = 28.0;   

update = () => {
    const delta = clock.getDelta();
    const elapsedTime = clock.getElapsedTime();
    
    const loopTime = elapsedTime % LOOP_DURATION;
    const baseFreq = (Math.PI * 2) / LOOP_DURATION;

    // Camera Flight
    const cameraZProgress = (loopTime / LOOP_DURATION) * (totalZSpan * 12);
    camera.position.z = -cameraZProgress;

    camera.position.x = Math.sin(loopTime * baseFreq * 8) * 0.7;
    camera.position.y = Math.cos(loopTime * baseFreq * 6) * 0.4;

    cameraTarget.set(
        Math.sin(loopTime * baseFreq * 8 + 0.5) * 0.3,
        Math.cos(loopTime * baseFreq * 6 + 0.5) * 0.15,
        camera.position.z - 4.0
    );
    camera.lookAt(cameraTarget);

    // Sky Planes Parallax
    skyPlanes.forEach(sky => {
        sky.mesh.lookAt(camera.position);

        let relativeZ = (sky.zStart - cameraZProgress) % totalZSpan;
        if (relativeZ > 2.0) relativeZ -= totalZSpan;
        if (relativeZ < -totalZSpan + 2.0) relativeZ += totalZSpan;
        
        sky.mesh.position.z = camera.position.z + relativeZ;
    });

    // Black Hole Mechanics & Chromatic Redshift
    blackHoles.forEach(bh => {
        const conf = bh.config;

        // Spatial Tumble Math
        bh.diskMesh.rotation.z = loopTime * baseFreq * conf.spinCycles;
        bh.mesh.rotation.x = loopTime * baseFreq * conf.rotCyclesX;
        bh.mesh.rotation.y = loopTime * baseFreq * conf.rotCyclesY;

        let relativeZ = (conf.zStart - cameraZProgress) % totalZSpan;
        if (relativeZ > 2.0) relativeZ -= totalZSpan;
        if (relativeZ < -totalZSpan + 2.0) relativeZ += totalZSpan;
        bh.mesh.position.z = camera.position.z + relativeZ;

        // CHROMATIC REDSHIFT ENGINE ENGINE
        // Generate a smooth 0.0 to 1.0 oscillating waveform tied strictly to the loop frequency
        // We add an index phase offset (bh.index * 1.5) so they all breathe asynchronously
        const colorOsc = Math.sin(loopTime * baseFreq * conf.colorWaveFreq + (bh.index * 1.5)) * 0.5 + 0.5;

        // Clear previous disk color frame
        bh.ctx.clearRect(0, 0, 512, 512);

        // Calculate dynamic shift positions for the energy bands
        const midPointStop = 0.1 + (colorOsc * 0.15); // Expands out slightly as gravity fluctuates
        const deepRedIntensity = Math.round(130 + (colorOsc * 125)); // Fluctuates between muted amber and vibrant red

        const grad = bh.ctx.createRadialGradient(256, 256, 110, 256, 256, 256);
        grad.addColorStop(0.0, 'rgba(255, 255, 255, 1.0)'); // Blinding energy hot-core
        grad.addColorStop(midPointStop, `rgba(255, ${Math.round(100 + (140 * (1 - colorOsc)))}, 0, 0.9)`); // Yellow to bright orange transition
        grad.addColorStop(0.5, `rgba(${deepRedIntensity}, 20, 0, 0.25)`); // Redshifting fringe outer bounds
        grad.addColorStop(1.0, 'rgba(0, 0, 0, 0.0)'); 

        bh.ctx.fillStyle = grad;
        bh.ctx.fillRect(0, 0, 512, 512);

        // Tell Three.js the pixel buffer has changed so it uploads the new canvas data to the GPU
        bh.texture.needsUpdate = true;
    });

    renderer.render(scene, camera);
}

s0.init({ src: renderer.domElement })

// --- Step 7: Post-Processing Polish Pipeline ---
src(s0)
    .blend(src(s0).scale(1.001), 0.1)
    .modulateScale(
        src(s0).luma(0.38).brightness(0.02), 
        -0.35 
    )
    .modulateRotate(
        src(s0).luma(0.1), 
        0.1
    )
    .contrast(1.3)
    .saturate(1.2)
    .out(o0)
